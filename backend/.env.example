# Copy to backend/.env and adjust as needed.

# Flask CLI entry point (used by `flask db ...` and `flask seed`)
FLASK_APP=run.py

# Leave empty to use SQLite at backend/instance/mogmatch.db.
# PostgreSQL example: postgresql://user:password@localhost:5432/mogmatch
DATABASE_URL=

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The seeded user that /api/profiles/me reads and edits until real auth exists.
DEMO_USER_EMAIL=demo@mogmatch.dev

# Port for `python run.py`
PORT=5001
