# Copy to backend/.env and adjust as needed.

# Flask CLI entry point (used by `flask db ...` and `flask seed`)
FLASK_APP=run.py

# Leave empty to use SQLite at backend/instance/mogmatch.db.
# PostgreSQL example: postgresql://user:password@localhost:5432/mogmatch
DATABASE_URL=

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The seeded user the app is demoed as (seeded username: jordan-dev).
DEMO_USER_EMAIL=demo@mogmatch.dev

# Signs the login cookie. Any long random string; change it if this ever leaves your laptop.
SECRET_KEY=dev-only-not-secret

# Password for every seeded user (log in with their username, e.g. jordan-dev, samfullstack).
SEED_PASSWORD=mogmatch-demo

# Port for `python run.py`
PORT=5001

# Project ideas in chat. Keep the real key in backend/.env, never in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
